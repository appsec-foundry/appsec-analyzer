{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/multi-repo-evidence-review.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "component_inventory_fingerprint",
    "decisions"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "source_scope_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "component_inventory_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "decisions": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "local_id",
          "verdict",
          "reason",
          "evidence"
        ],
        "properties": {
          "local_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "verdict": {
            "enum": [
              "verified",
              "refuted",
              "ambiguous"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 10,
            "maxLength": 500
          },
          "exploit_conditions": {
            "description": "Independent explanation of exploitation without an input-to-sink trace. Required by the controller at thorough depth when verifying a confirmed-exploitable finding without mechanism_trace. Indices refer to this decision's evidence array, starting at zero.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["access", "effect", "controls"],
            "properties": {
              "access": {"$ref": "#/$defs/exploit_condition"},
              "effect": {"$ref": "#/$defs/exploit_condition"},
              "controls": {"$ref": "#/$defs/exploit_condition"}
            }
          },
          "evidence": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "exploit_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason", "evidence_indices"],
      "properties": {
        "reason": {
          "type": "string",
          "minLength": 20,
          "maxLength": 500,
          "pattern": "\\S"
        },
        "evidence_indices": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 7}
        }
      }
    }
  }
}
