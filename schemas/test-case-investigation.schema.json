{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appsec-advisor/schemas/test-case-investigation.schema.json",
  "title": "Test case investigation of one component and one aspect",
  "description": "REQ-040 pilot. One reply answers every enabled, applicable test case of one aspect for one component, or the share of their candidates that one of several jobs holds. Load it through contexts/case_analysis.contract: each findings item is the STRIDE threat item of multi-repo-stride.schema.json, which the loader closes with the extension fields given here, so the two cannot drift. The controller sets the identity fields and fixes the anchor and route of each pre-check candidate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_scope_sha256",
    "component_inventory_fingerprint",
    "component_id",
    "aspect",
    "test_cases",
    "findings",
    "discovery_escapes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_scope_sha256": {"$ref": "https://appsec-advisor/schemas/multi-repo-stride.schema.json#/properties/source_scope_sha256"},
    "component_inventory_fingerprint": {"$ref": "https://appsec-advisor/schemas/multi-repo-stride.schema.json#/properties/component_inventory_fingerprint"},
    "component_id": {"$ref": "https://appsec-advisor/schemas/multi-repo-stride.schema.json#/properties/component_id"},
    "aspect": {"enum": ["IAM", "SessionMgmt", "AuthZ", "InputVal", "DataProt"]},
    "test_cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["test_case_id", "proposed_outcome", "reason", "candidates"],
        "properties": {
          "test_case_id": {"type": "string", "pattern": "^TC-[A-Z]+-[0-9]{2}$"},
          "proposed_outcome": {"enum": ["finding", "control", "partial", "no_finding", "undecidable"]},
          "reason": {"type": "string", "minLength": 1, "maxLength": 300},
          "candidates": {
            "type": "array",
            "maxItems": 60,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["candidate_id", "origin", "status", "evidence", "finding_ids"],
              "properties": {
                "candidate_id": {"type": "string", "pattern": "^(?:pc-[0-9a-f]{16}|m-[1-9][0-9]{0,2})$"},
                "origin": {"enum": ["pre-check", "model"]},
                "anchor": {"$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"},
                "route_id": {"type": "string", "pattern": "^R-[0-9]{3,5}$"},
                "status": {"enum": ["weakness", "control", "neither", "rejected", "undecidable"]},
                "control_kind": {"enum": ["code", "configuration"]},
                "rejection": {"enum": ["public-by-design", "unreachable", "outside-objective", "duplicate", "not-a-weakness"]},
                "undecidable_reason": {"enum": ["external-control", "missing-source", "conflicting-evidence"]},
                "evidence": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {"$ref": "https://appsec-advisor/schemas/fragments/components-v2.schema.json#/$defs/evidence"}
                },
                "finding_ids": {
                  "type": "array",
                  "maxItems": 8,
                  "uniqueItems": true,
                  "items": {"type": "string", "minLength": 1, "maxLength": 80}
                },
                "note": {"type": "string", "minLength": 1, "maxLength": 240}
              },
              "allOf": [
                {
                  "if": {"properties": {"origin": {"const": "pre-check"}}},
                  "then": {"properties": {"candidate_id": {"pattern": "^pc-"}}, "not": {"required": ["anchor"]}},
                  "else": {"properties": {"candidate_id": {"pattern": "^m-"}}, "required": ["anchor"]}
                },
                {
                  "if": {"properties": {"status": {"const": "control"}}},
                  "then": {"required": ["control_kind"]},
                  "else": {"not": {"required": ["control_kind"]}}
                },
                {
                  "if": {"properties": {"status": {"const": "rejected"}}},
                  "then": {"required": ["rejection"]},
                  "else": {"not": {"required": ["rejection"]}}
                },
                {
                  "if": {"properties": {"status": {"const": "undecidable"}}},
                  "then": {"required": ["undecidable_reason"]},
                  "else": {"not": {"required": ["undecidable_reason"]}}
                },
                {
                  "if": {"properties": {"status": {"enum": ["weakness", "control", "rejected"]}}},
                  "then": {"properties": {"evidence": {"minItems": 1}}}
                },
                {
                  "if": {"properties": {"status": {"const": "weakness"}}},
                  "then": {"properties": {"finding_ids": {"minItems": 1}}},
                  "else": {"properties": {"finding_ids": {"maxItems": 0}}}
                }
              ]
            }
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "$ref": "https://appsec-advisor/schemas/multi-repo-stride.schema.json#/properties/threats/items",
        "properties": {
          "test_case_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^TC-[A-Z]+-[0-9]{2}$"}
          },
          "candidate_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 60,
            "uniqueItems": true,
            "items": {"type": "string", "pattern": "^(?:pc-[0-9a-f]{16}|m-[1-9][0-9]{0,2})$"}
          }
        },
        "required": ["test_case_ids", "candidate_ids"]
      }
    },
    "discovery_escapes": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reason", "test_case_id", "search_paths"],
        "properties": {
          "reason": {"enum": ["missing-control-proof", "ambiguous-data-flow", "other-entry-point", "variant-check"]},
          "test_case_id": {"type": "string", "pattern": "^TC-[A-Z]+-[0-9]{2}$"},
          "search_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 15,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1, "maxLength": 512}
          }
        }
      }
    }
  }
}
