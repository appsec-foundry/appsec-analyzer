exclude agents/appsec-stride-analyzer-v2.md
recursive-include data *.yaml *.json *.md
recursive-include schemas *.yaml *.json *.md
recursive-include templates *.j2 *.md
recursive-include examples *.yaml *.json *.md *.sdd *.yml
recursive-include examples/organization-distribution *.py *.toml *.cfg *.in *.lock *.sh *.example
include examples/organization-distribution/.gitignore
include skills/appsec-analyzer/SKILL.md skills/appsec-analyzer/business-context.md skills/appsec-analyzer/claude-code.md
