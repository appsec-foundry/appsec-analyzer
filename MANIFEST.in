include skills/analyze-threats/references/analysis-contract.md
include skills/analyze-threats/SKILL.md skills/analyze-threats/HELP.txt
include skills/audit-security-requirements/config.json
recursive-include docs *.md
global-exclude *.pyc *.pyo .DS_Store
prune tests
