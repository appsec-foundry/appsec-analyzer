include LICENSE README.md SECURITY.md engine.json
recursive-include appsec_analyzer *.py
recursive-include scripts/analyzers *.py
recursive-include scripts/contexts *.py
recursive-include scripts/exporters *.py
recursive-include scripts/model *.py
recursive-include scripts/orchestrator *.py
recursive-include scripts/renderers *.py
recursive-include scripts/repairs *.py
recursive-include scripts/requirements *.py
recursive-include scripts/runtime *.py
recursive-include scripts/shared *.py
recursive-include scripts/validators *.py
recursive-include scripts/assets *.css
include scripts/appsec-analyst-cli scripts/mermaid_validate.mjs
exclude scripts/runtime/plugin_meta.py scripts/runtime/plugin_read_gate.py scripts/runtime/plugin_write_gate.py
exclude scripts/runtime/appsec_status.py scripts/runtime/session_banner.py scripts/runtime/version_status.py scripts/analyzers/security_steering.py
